---
import { getChapters, toLang } from '../lib/notes';

interface Props {
  course: string;
}

const lang = toLang(Astro.locals.starlightRoute.lang);
const chapters = await getChapters(Astro.props.course, lang);
---

<div class="chapters not-content">
  <ol>
    {
      chapters.map((chapter) => (
        <li>
          <span class="chapters__num" aria-hidden="true">
            {String(chapter.number).padStart(2, '0')}
          </span>
          <div>
            <a href={chapter.href}>{chapter.title}</a>
            {chapter.description && <p>{chapter.description}</p>}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .chapters {
    margin-top: 1.25rem;
    border: 1px solid var(--nb-border);
    border-radius: 0.9rem;
    overflow: hidden;
  }


  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    gap: 0.9rem;
    padding: 0.85rem 1.1rem;
  }

  li + li {
    border-top: 1px solid var(--nb-rule);
  }

  .chapters__num {
    display: grid;
    flex: none;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1.5px solid var(--nb-border);
    border-radius: 50%;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }


  a {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }

  a:hover {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
  }

  p {
    margin: 0.15rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
</style>
