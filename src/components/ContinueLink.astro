---
import { t, toLang, type ChapterInfo } from '../lib/notes';

interface Props {
  chapters: ChapterInfo[];
  /** Where to send the reader once every chapter is studied. */
  doneHref?: string;
}

const { chapters, doneHref } = Astro.props;
const text = t(toLang(Astro.locals.starlightRoute.lang));
const [first] = chapters;
const data = chapters.map(({ slug, href, label }) => ({ slug, href, label }));
---

{
  first && (
    <a
      class="continue"
      href={first.href}
      data-continue={JSON.stringify(data)}
      data-start-text={text.start}
      data-continue-text={text.continue}
      data-done-text={text.review}
      data-done-href={doneHref}
    >
      <span data-continue-verb>{text.start}</span>
      <span class="continue__label" data-continue-label>
        {first.label}
      </span>
      <span aria-hidden="true">→</span>
    </a>
  )
}

<style>
  .continue {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    border-radius: 0.5rem;
    background: var(--sl-color-text-accent);
    padding: 0.5rem 0.9rem;
    color: var(--sl-color-black);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .continue:hover {
    filter: brightness(1.1);
  }

  .continue:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .continue__label:empty {
    display: none;
  }

  .continue__label {
    font-weight: 500;
    opacity: 0.85;
  }
</style>
