---
import { chapterCount, courseOf, getChapters, slugOf, t, toLang } from '../lib/notes';

const route = Astro.locals.starlightRoute;
const { title, description, kind } = route.entry.data;
const lang = toLang(route.lang);
const text = t(lang);
const slug = slugOf(route.id);
const course = courseOf(route.id);

let eyebrow: string | undefined;
if (kind === 'home') {
  eyebrow = text.notebook;
} else if (course) {
  const chapters = await getChapters(course.id, lang);
  const number = chapters.find((chapter) => chapter.slug === slug)?.number;
  const detail = {
    chapter: number && `${text.chapter} ${number} ${text.of} ${chapters.length}`,
    overview: `${text.overview} · ${chapterCount(chapters.length, lang)}`,
    cheatsheet: text.cheatsheet,
    sources: text.sources,
    home: undefined,
  }[kind ?? 'chapter'];
  eyebrow = [course.label[lang], detail].filter(Boolean).join(' · ');
}
---

<header class="page-head">
  {
    (eyebrow || kind === 'chapter') && (
      <div class="page-meta">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        {kind === 'chapter' && (
          <button type="button" class="study-toggle" data-study-toggle={slug} aria-pressed="false">
            <span class="study-toggle__box" aria-hidden="true" />
            <span class="study-toggle__off">{text.markStudied}</span>
            <span class="study-toggle__on">{text.studied}</span>
          </button>
        )}
      </div>
    )
  }
  <h1 id="_top">{title}</h1>
  {description && <p class="lead">{description}</p>}
</header>

<script>
  import '../scripts/study';
</script>

<style>
  .page-head {
    margin-top: 1rem;
  }

  .page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.75rem;
  }

  .eyebrow {
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
  }

  .lead {
    max-width: 40rem;
    margin-top: 0.75rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-lg);
    line-height: 1.55;
  }

  .study-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    border: 1px solid var(--nb-border);
    border-radius: 999px;
    background: var(--sl-color-bg);
    padding: 0.25rem 0.8rem 0.25rem 0.5rem;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }

  .study-toggle:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  .study-toggle:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .study-toggle__box {
    display: grid;
    width: 1rem;
    height: 1rem;
    place-items: center;
    border: 1.5px solid currentColor;
    border-radius: 0.3rem;
  }

  .study-toggle__on,
  .study-toggle[aria-pressed='true'] .study-toggle__off {
    display: none;
  }

  .study-toggle[aria-pressed='true'] .study-toggle__on {
    display: inline;
  }

  .study-toggle[aria-pressed='true'] {
    border-color: var(--nb-done);
    background: var(--nb-done-bg);
    color: var(--nb-done);
    font-weight: 600;
  }

  .study-toggle[aria-pressed='true'] .study-toggle__box {
    border-color: var(--nb-done);
    background: var(--nb-done);
  }

  .study-toggle[aria-pressed='true'] .study-toggle__box::after {
    content: '';
    width: 0.3rem;
    height: 0.55rem;
    margin-top: -0.1rem;
    border: solid var(--sl-color-black);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
</style>
