---
import { chapterCount, courseOf, getChapters, slugOf, t, toLang } from '../lib/notes';

const route = Astro.locals.starlightRoute;
const { title, description, kind } = route.entry.data;
const lang = toLang(route.lang);
const text = t(lang);
const slug = slugOf(route.id);
const course = courseOf(route.id);

let eyebrow: string | undefined;
if (kind === 'home') {
  eyebrow = text.notebook;
} else if (course) {
  const chapters = await getChapters(course.id, lang);
  const number = chapters.find((chapter) => chapter.slug === slug)?.number;
  const detail = {
    chapter: number && `${text.chapter} ${number} ${text.of} ${chapters.length}`,
    overview: `${text.overview} · ${chapterCount(chapters.length, lang)}`,
    cheatsheet: text.cheatsheet,
    sources: text.sources,
    home: undefined,
  }[kind ?? 'chapter'];
  eyebrow = [course.label[lang], detail].filter(Boolean).join(' · ');
}
---

<header class="page-head">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 id="_top">{title}</h1>
  {description && <p class="lead">{description}</p>}
</header>

<style>
  .page-head {
    margin-top: 1rem;
  }

  .eyebrow {
    margin-bottom: 0.6rem;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
  }

  .lead {
    max-width: 40rem;
    margin-top: 0.75rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-lg);
    line-height: 1.55;
  }

</style>
