---
import { t, toLang, type ChapterInfo } from '../lib/notes';

interface Props {
  chapters: ChapterInfo[];
}

const { chapters } = Astro.props;
const text = t(toLang(Astro.locals.starlightRoute.lang));
---

<div class="meter" data-study-progress={chapters.map((chapter) => chapter.slug).join(',')}>
  <div class="meter__track"><div class="meter__fill"></div></div>
  <span class="meter__label"><span data-study-count>0</span> / {chapters.length} {text.progress}</span>
</div>

<style>
  .meter {
    --progress: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .meter__track {
    flex: 1;
    height: 0.4rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
  }

  .meter__fill {
    width: calc(var(--progress) * 100%);
    height: 100%;
    border-radius: inherit;
    background: var(--nb-done);
    transition: width 250ms ease;
  }

  .meter__label {
    flex: none;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-variant-numeric: tabular-nums;
  }
</style>
