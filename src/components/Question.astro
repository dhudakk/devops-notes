---
import { inlineCode } from '../lib/notes';

interface Props {
  /** The question. Wrap code in `backticks`. */
  q: string;
}

const { q } = Astro.props;
---

<details class="question">
  <summary><span class="question__q" set:html={inlineCode(q)} /></summary>
  <div class="question__answer"><slot /></div>
</details>

<style>
  .question {
    padding: 0;
    margin-top: 0.6rem;
    border: 1px solid var(--nb-rule);
    border-radius: 0.6rem;
    background: var(--sl-color-bg);
  }

  .question + :global(.question) {
    margin-top: 0.5rem;
  }

  summary {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    padding: 0.7rem 1rem;
    color: var(--sl-color-white);
    font-weight: 600;
    line-height: 1.5;
    cursor: pointer;
    list-style: none;
  }

  /* long inline code in a question must wrap instead of widening the page */
  .question__q {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::before {
    -webkit-mask-image: none;
    mask-image: none;
    background: transparent;
    vertical-align: baseline;
    content: '?';
    display: grid;
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    place-items: center;
    border: 1.5px solid var(--sl-color-text-accent);
    border-radius: 50%;
    color: var(--sl-color-text-accent);
    font-size: 0.8rem;
    font-weight: 800;
    transform: translateY(0.15rem);
  }

  details[open] > summary::before {
    content: '✓';
    border-color: var(--nb-done);
    background: var(--nb-done);
    color: var(--sl-color-black);
  }

  summary:hover {
    color: var(--sl-color-text-accent);
  }

  summary:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
    border-radius: 0.6rem;
  }

  .question__answer {
    border-top: 1px dashed var(--nb-rule);
    padding: 0.75rem 1rem 0.9rem 3rem;
  }

  .question__answer > :global(:first-child) {
    margin-top: 0;
  }
</style>
