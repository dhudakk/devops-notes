---
import { t, toLang } from '../lib/notes';

interface Props {
  /** `hint` renders a lighter "Hint" toggle instead of "Solution". */
  variant?: 'solution' | 'hint';
}

const { variant = 'solution' } = Astro.props;
const text = t(toLang(Astro.locals.starlightRoute.lang));
---

<details class:list={['reveal', `reveal--${variant}`]}>
  <summary>{variant === 'hint' ? text.hint : text.solution}</summary>
  <div class="reveal__body"><slot /></div>
</details>

<style>
  .reveal {
    padding: 0;
    margin-top: 1rem;
    border: 1px solid var(--nb-border);
    border-radius: 0.6rem;
  }

  .reveal--hint {
    border-style: dashed;
  }

  summary {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::before {
    -webkit-mask-image: none;
    mask-image: none;
    background: transparent;
    vertical-align: baseline;
    content: '';
    flex: none;
    width: 0.55rem;
    height: 0.55rem;
    margin-inline: 0.1rem 0.15rem;
    border: solid currentColor;
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(-45deg);
    transition: transform 150ms ease;
  }

  details[open] > summary::before {
    transform: rotate(45deg) translate(-0.1rem, -0.1rem);
  }

  summary:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
    border-radius: 0.6rem;
  }

  details[open] > summary {
    border-bottom: 1px solid var(--nb-rule);
  }

  .reveal__body {
    padding: 0.25rem 0.9rem 0.9rem;
  }
</style>
